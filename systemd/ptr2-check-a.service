[Unit]
Description=ptr2: этап 04 — проверка прямых A-записей хостнеймов (a_record_checks)
Documentation=https://github.com/snovitsi/ptr2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ptr2
Group=ptr2
WorkingDirectory=/opt/ptr2
EnvironmentFile=-/etc/ptr2/ptr2.env
# --from-queue --once: вычерпать очередь a_checks и завершиться
ExecStart=/opt/ptr2/.venv/bin/python -m ptr2.scripts.04_check_a --from-queue --once --limit $A_LIMIT --batch $A_BATCH
TimeoutStartSec=3600
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/ptr2/logs
Restart=no
