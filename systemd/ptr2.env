# =============================================================================
# ptr2 — общие настройки systemd-юнитов (сервисы/таймеры этапов пайплайна).
# Устанавливается скриптом install_services.sh в /etc/ptr2/ptr2.env (chmod 640,
# владелец root:ptr2; юниты читают его через EnvironmentFile и запускаются
# от пользователя ptr2). Здесь — только параметры РАСПИСАНИЯ и параллелизма;
# DATABASE_URL / REDIS_URL и прочее живут в /opt/ptr2/.env (читается config.py).
#
# Все значения ниже можно переопределить без правки файла:
#   systemctl edit ptr2-check-a.service   # и там же задать свои Environment=
# =============================================================================

# --- Расположение проекта -----------------------------------------------------
IPRECON_HOME=/opt/ptr2

# --- Общие флаги запусков ------------------------------------------------------
# Уровень логирования python-этапов (DEBUG/INFO/WARNING)
LOG_LEVEL=INFO
# Хост-тег в строках логов (пусто = hostname машины)
WORKER_TAG=

# --- Этап 00: скачивание RIPE ---------------------------------------------------
# Принудительное скачивание RIPE каждый запуск (игнор кэша по хешу/TTL).
# Обычно пусто: файл обновляется ~1 раз в сутки, повторная загрузка не нужна.
# Значение 'true' превратится в флаг --force-download при установке юнитов.
FORCE_DOWNLOAD=

# --- Этап 02: PTR-воркер (долгоживущий сервис ptr2-ptr-worker) -----------------
# Сколько воркеров на этой машине (каждый = свой процесс, Restart=always)
PTR_WORKERS=2
# Максимум семей /24 одновременно (анти-BAN, учитывайте ВСЕ сервера кластера!)
SPREAD_MAX_CONCURRENT=8
# Промежуток между перехватами «зависших» задач из PEL (минуты)
RECLAIM_INTERVAL_MIN=5

# --- Этап 03: вычитка результатов PTR ------------------------------------------
LOAD_BATCH=1000

# --- Этап 04: проверка A-записей ------------------------------------------------
A_LIMIT=100000
A_BATCH=200

# --- Этап 05: проверка доступности веб-серверов --------------------------------
WEB_LIMIT=10000
WEB_BATCH=100

# --- Этап 06: детекция OWA / Exchange -------------------------------------------
OWA_LIMIT=5000
OWA_BATCH=50

# --- Этап 07: отчёт --------------------------------------------------------------
REPORT_FORMAT=table

# --- Таймеры: включение и расписания (OnCalendar-синтаксис systemd) ------------
TIMER_FETCH=true
FETCH_ON_CALENDAR=*-*-* 03:15:00          # ежедневно после обновления RIPE (~03:00 UTC)

TIMER_SHARD=false
SHARD_ON_CALENDAR=*-*-* 04:00:00          # редкий полный пересев шардов (по желанию)

TIMER_LOAD_PTR=true
LOAD_PTR_ON_CALENDAR=*:00/10

TIMER_CHECK_A=true
CHECK_A_ON_CALENDAR=*:00/15

TIMER_CHECK_WEB=true
CHECK_WEB_ON_CALENDAR=*:00/30

TIMER_CHECK_OWACHK=true
CHECK_OWACHK_ON_CALENDAR=*:00/45

TIMER_REPORT=true
REPORT_ON_CALENDAR=*-*-* 09:00:00          # ежедневно утром

# Случайная задержка старта таймеров (раскидывает этапы по времени), напр. 5m
RANDOMIZED_DELAY_SEC=300
# (секунды; подставляется в RandomizedDelaySec при установке юнитов)
