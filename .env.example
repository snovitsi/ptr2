# =============================================================================
# ptr2 — пример конфигурации. Скопируйте в .env и поправьте под себя:
#     cp .env.example .env
# Файл .env читается автоматически (ptr2/config.py), а также подхватывается
# скриптами run_pipeline.sh / setup_env.sh. Пустое значение = default из кода.
# =============================================================================

# --- Внешние источники --------------------------------------------------------
RIPE_URL=https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-latest
DATA_DIR=./data
# Этап 00 скачивает RIPE только если локального файла нет, ему больше TTL
# часов или изменился SHA-256 содержимого (файл обновляется ~1 раз в сутки).
RIPE_CACHE_TTL_HOURS=24
# true — всегда скачивать заново (то же самое, что ./run_pipeline.sh --force-download)
FORCE_DOWNLOAD=false

# --- Критерии отбора диапазонов (этап 1) --------------------------------------
# CC-коды стран через запятую; пусто = все страны
TARGET_COUNTRIES=DE,NL,FR
# Фильтр по длине префикса выровненных CIDR (24/24 = только /24)
MIN_PREFIX_LEN=24
MAX_PREFIX_LEN=24
# Фильтр по размеру диапазона в адресах; 0 = не ограничивать
MIN_RANGE_SIZE=0
MAX_RANGE_SIZE=0
# Размер шарда (количество адресов в одной задаче PTR-обхода)
SHARD_SIZE=256

# --- Хранилища ----------------------------------------------------------------
# PostgreSQL (префикс +psycopg/+asyncpg игнорируется, схема нормализуется)
DATABASE_URL=postgresql+psycopg://ptr2:ptr2@localhost:5432/ptr2
# Redis
# Хост и порт для проверок setup_env.sh берутся отсюда; при внешнем сервере
# автозапуск сервиса и sudo-создание роли/БД пропускаются (роль готовит админ).
# FORCE_LOCAL_SERVICES=true — принудительно поднимать локальные сервисы даже при внешнем URL.
REDIS_URL=redis://localhost:6379/0

# --- Анти-BAN / стратификация DNS-нагрузки ------------------------------------
SPREAD_ENABLED=true
FAMILY_BITS=24
SPREAD_MAX_CONCURRENT=8
SPREAD_LEASE_SEC=900
PTR_SHUFFLE_WITHIN_SHARD=true

# --- DNS (этапы 2, 4) -----------------------------------------------------------
# Свои resolvers через запятую; пусто = системные из /etc/resolv.conf
DNS_NAMESERVERS=
DNS_TIMEOUT=2.0
DNS_LIFETIME=3.0
PTR_CONCURRENCY=100
PTR_RATE_LIMIT=200
A_CONCURRENCY=50
SKIP_NET_AND_BROADCAST=true

# --- HTTP (этапы 5, 6) ------------------------------------------------------------
HTTP_CONCURRENCY=30
HTTP_TIMEOUT=10
VERIFY_TLS=false
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
# --- Очереди: списковые (legacy, USE_STREAMS=false) ----------------------------
QUEUE_SHARDS_PTR=ptr2:queue:ptr_shards
QUEUE_PTR_RESULTS=ptr2:queue:ptr_results
QUEUE_A_CHECKS=ptr2:queue:a_checks
QUEUE_WEB_CHECKS=ptr2:queue:web_checks
QUEUE_OWACHK_CHECKS=ptr2:queue:owa_checks

# --- Очереди: Redis Streams (распределённый режим, по умолчанию) ---------------
USE_STREAMS=true
STREAM_PTR_SHARDS=ptr2:stream:ptr_shards
STREAM_PTR_RESULTS=ptr2:stream:ptr_results
STREAM_A_CHECKS=ptr2:stream:a_checks
STREAM_WEB_CHECKS=ptr2:stream:web_checks
STREAM_OWACHK_CHECKS=ptr2:stream:owa_checks
CONSUMER_GROUP=workers
CLAIM_IDLE_MS=120000
WORKER_ID=

# --- Прочее ----------------------------------------------------------------------
OWA_PATHS=/owa/,/owa/auth/logon.aspx,/autodiscover/autodiscover.xml
DB_BATCH_SIZE=1000
LOG_LEVEL=INFO
LOG_DIR=
LOG_TO_FILE=true
REDIS_CONNECT_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
